# Filled in with real BSC / PancakeSwap addresses found via web search
# (Sep 24, 2026). Verify these still match current pool/fee tiers before
# trading real size -- pools get created/retired and liquidity migrates,
# especially for small/new tokens.

RPC_URL=https://bsc-dataseed.binance.org/
CHAIN_ID=56

# Only needed if you later add real execution on top of this bot.
# Leave PRIVATE_KEY empty to run in simulation-only mode.
